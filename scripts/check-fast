#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "=== PHP syntax ==="
find . -path './.git' -prune -o -path './vendor' -prune -o -type f -name '*.php' -print0 \
	| xargs -0 -r -n1 php -l >/dev/null
echo "PHP syntax: OK"

if compgen -G 'tests/*-smoke.php' >/dev/null; then
	echo
	echo "=== Component smoke tests ==="
	for test_file in tests/*-smoke.php; do
		php "$test_file"
	done
fi

echo
echo "=== JavaScript tests ==="
command -v node >/dev/null 2>&1 || { echo 'Node.js fehlt für die JavaScript-Tests.' >&2; exit 1; }
node tests/run-js.mjs

if [[ -x vendor/bin/phpcs ]]; then
	echo
	echo "=== PHPCS security baseline ==="
	vendor/bin/phpcs --standard=phpcs.xml.dist
else
	echo
	echo "PHPCS: skipped (run composer install to provide vendor/bin/phpcs)"
fi

echo
echo "=== Diff hygiene ==="
git diff --check

echo
echo "OK: fast component checks completed."
